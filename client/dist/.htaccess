# SPA routing for /pair, /login, /display, etc. (Apache/cPanel)
AddType application/javascript .js
AddType text/css .css
AddType application/json .webmanifest

RewriteEngine On

RewriteRule ^assets/.+ - [L]
RewriteRule ^.*\.(js|css|png|jpg|jpeg|svg|woff|woff2|webmanifest|ico)$ - [L]

RewriteCond %{REQUEST_URI} ^/api
RewriteRule ^(.*)$ http://127.0.0.1:4000/$1 [P,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]

<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

<FilesMatch "\.(js|css|png|jpg|jpeg|svg|woff|woff2|webmanifest)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
